{
  "name": "stock-treemap",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:server": "pnpm build && vite build -c vite.server.config.ts",
    "preview": "pnpm build && vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "start": "node dist/server/index.mjs",
    "typecheck": "vue-tsc -b",
    "cf-typegen": "wrangler types",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@vueuse/core": "^15.0.0",
    "d3-hierarchy": "^3.1.2",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "~5.9.3",
    "unocss": "^66.11.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.151.2"
  }
}
